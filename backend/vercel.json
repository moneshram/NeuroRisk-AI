{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "ml/**",
          "!ml/artifacts/backup/**",
          "!ml/samples/**",
          "!instance/**",
          "!venv/**",
          "!tests/**",
          "!**/__pycache__/**",
          "!.env",
          "!.env.*"
        ],
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
