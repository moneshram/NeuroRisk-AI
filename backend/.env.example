# NeuroRisk AI backend environment variables
# -------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# JWT secret for signing access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_your_generated_secret

# ----- Database (REQUIRED for Vercel production) -----
# For local development: leave unset (uses backend/instance/stroke.db).
# For Vercel: this MUST be set to a persistent PostgreSQL URL.
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
#
# Free PostgreSQL providers (all work with this app):
#   - Neon:       https://neon.tech  (free tier, 0.5 GB)
#   - Supabase:   https://supabase.com (free tier, 500 MB)
#   - Railway:    https://railway.app (free tier, trial)
#
# The postgres:// prefix is automatically normalised to postgresql://.
# After setting this, run the migration to import existing SQLite data:
#   export DATABASE_URL="your-postgres-url-here"
#   python migrate_sqlite_to_postgres.py
DATABASE_URL=

# ----- SMTP / Email configuration -----
# Required for password-reset OTP emails to be sent.
# For Gmail, use an App Password (NOT your normal login password).
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2FA enabled on the Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_TIMEOUT=20

# Sender address shown in the "From" field of password-reset emails.
# If omitted, falls back to SMTP_USERNAME.
MAIL_FROM=Neuro Risk AI 

# ----- Async mail queue -----
MAIL_WORKERS=4
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_DELAY_SECONDS=5

# ----- CORS -----
# Comma-separated list of frontend origins allowed to call this API.
# In production this must include the deployed frontend URL(s).
# For local development use http://localhost:5173 (Vite default).
FRONTEND_ORIGIN=http://localhost:5173

# ----- Google Sign-In (optional) -----
# Web OAuth client ID. Use the same value in the frontend VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
