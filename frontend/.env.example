# For local development, use the local Flask backend:
VITE_API_URL=http://127.0.0.1:5000/api

# For Vercel production, set this in the Vercel dashboard (Settings → Environment Variables):
# VITE_API_URL=https://neuro-risk-ai-3i5o.vercel.app/api
#
# IMPORTANT: The URL above uses the LETTER "o" in "3i5o", NOT the digit "0".
# If you use "3i50" (digit zero), all API requests will fail with "Failed to fetch"
# because that deployment does not exist on Vercel.

# Google Identity Services Web OAuth client ID.
# Add the same client ID to backend/.env as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
